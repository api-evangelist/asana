      "name": "Batch API",
      "description": {
        "content": "Perform multiple operations in a single HTTP request.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "8a62a38c-0b67-41ed-8bcc-854a4aba500b",
          "name": "Asana Submit parallel requests",
          "request": {
            "name": "Asana Submit parallel requests",
            "description": {
              "content": "Make multiple API requests in a single call. The maximum number of actions allowed in a single batch request is 10.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "batch"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "opt_pretty",
                  "value": "<boolean>",
                  "description": "Provides “pretty” output.\nProvides the response in a “pretty” format. In the case of JSON this means doing proper line breaking and indentation to make it readable. This will take extra time and increase the response size so it is advisable only to use this during debugging."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"actions\": [\n      {\n        \"relative_path\": \"<string>\",\n        \"method\": \"<string>\",\n        \"data\": \"<object>\",\n        \"options\": {\n          \"limit\": \"<integer>\",\n          \"offset\": \"<string>\",\n          \"fields\": [\n            \"<string>\",\n            \"<string>\"\n          ]\n        }\n      },\n      {\n        \"relative_path\": \"<string>\",\n        \"method\": \"<string>\",\n        \"data\": \"<object>\",\n        \"options\": {\n          \"limit\": \"<integer>\",\n          \"offset\": \"<string>\",\n          \"fields\": [\n            \"<string>\",\n            \"<string>\"\n          ]\n        }\n      }\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
