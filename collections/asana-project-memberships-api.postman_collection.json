  "item": [
    {
      "id": "b0c3f663-665f-4f57-9b40-551334c68cf3",
      "name": "Project Memberships",
      "description": {
        "content": "With the introduction of “comment-only” projects in Asana, a user’s membership in a project comes with associated permissions. These permissions (i.e., whether a user has full access to the project or comment-only access) are accessible through the project memberships endpoints described here.",
        "type": "text/plain"
      },
